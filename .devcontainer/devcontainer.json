{
  "name": "RupeeShield (FastAPI + React)",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app/main.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt; cd frontend && npm ci; echo 'Packages installed'",
  "postAttachCommand": {
    "server": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "RupeeShield API",
      "onAutoForward": "openPreview"
    },
    "5173": {
      "label": "RupeeShield dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}
