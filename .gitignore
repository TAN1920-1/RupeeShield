# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ---- local runtime state -----------------------------------------------------
# The SQLite database is created on first startup and is never committed.
rupeeshield.db
rupeeshield.db-wal
rupeeshield.db-shm
*.log

# Local overrides. `.env.example` is committed; `.env` is not, because it may hold
# machine-specific paths or secrets.
.env

# ---- generated data ----------------------------------------------------------
# The generator is seeded, so the datasets are reproducible rather than precious.
# Regenerate with: python scripts/generate_dataset.py
data/transactions.csv
data/users.csv
data/feature_table.parquet
# Threshold overrides written by PATCH /api/settings (machine-specific state).
data/thresholds.json

# ---- frontend ----------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# ---- editors / OS ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
