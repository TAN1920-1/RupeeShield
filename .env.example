# RupeeShield configuration.
#
# Every setting can be overridden with an environment variable prefixed
# `RUPESHIELD_`. Copy this file to `.env` (which is git-ignored) and edit as needed;
# `app/core/config.py` reads `.env` from the repository root automatically.
#
# Defaults are chosen so that the project runs with no configuration at all.

# -- application ---------------------------------------------------------------
RUPESHIELD_APP_NAME=RupeeShield
RUPESHIELD_ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
RUPESHIELD_LOG_LEVEL=INFO

# -- storage -------------------------------------------------------------------
# SQLite keeps the whole project self-contained. Point this at PostgreSQL only if
# you deliberately want a shared database; nothing else in the app needs changing.
# RUPESHIELD_DATABASE_URL=sqlite:///./rupeeshield.db

# -- paths ---------------------------------------------------------------------
# RUPESHIELD_MODEL_DIR=./models
# RUPESHIELD_DATA_DIR=./data

# -- browser access ------------------------------------------------------------
# Origins allowed to call the API. The Vite dev server is the default.
RUPESHIELD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# -- simulation limits (guard rails against accidental runaway runs) -----------
RUPESHIELD_DEFAULT_SEED=42
RUPESHIELD_MAX_SIMULATION_EVENTS=1500
RUPESHIELD_MAX_BATCH_EVENTS=6000
RUPESHIELD_DEFAULT_STREAM_PACE_PER_SECOND=12

# -- API limits ----------------------------------------------------------------
RUPESHIELD_MAX_PAGE_SIZE=500
RUPESHIELD_RATE_LIMIT_REQUESTS_PER_MINUTE=240

# -- training ------------------------------------------------------------------
# Training through the API is deliberately off: it is CPU-heavy and the documented
# workflow is the command line (`python -m app.ml.train`). Set to true to allow
# POST /api/ml/train from the ML Model Evaluation page.
RUPESHIELD_ENABLE_API_TRAINING=false

# -- decision / detection thresholds -------------------------------------------
# These are data, not constants, because the Defense Comparison Lab exists to show
# that changing them changes the outcome. Nested values use a double underscore.
RUPESHIELD_THRESHOLDS__BLOCK_THRESHOLD=0.80
RUPESHIELD_THRESHOLDS__FLAG_THRESHOLD=0.45
RUPESHIELD_THRESHOLDS__RULE_VELOCITY_10MIN=5
RUPESHIELD_THRESHOLDS__RULE_VELOCITY_1H=8
RUPESHIELD_THRESHOLDS__RULE_AMOUNT_ZSCORE=4.0
RUPESHIELD_THRESHOLDS__RULE_AMOUNT_OVER_AVG=5.0
RUPESHIELD_THRESHOLDS__FAILED_LOGIN_BURST=5
RUPESHIELD_THRESHOLDS__FAILED_LOGIN_WINDOW_MINUTES=10
RUPESHIELD_THRESHOLDS__CORRELATION_LOOKBACK_MINUTES=30
# Minor units (paise): 40000 = INR 400.00
RUPESHIELD_THRESHOLDS__NEW_DEVICE_HIGH_VALUE_MINOR=40000
RUPESHIELD_THRESHOLDS__COORDINATED_FANOUT_BENEFICIARIES=3
